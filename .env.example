# Express만 읽습니다. 브라우저 번들에 넣지 마세요.
API_PORT=43128

# 행 보안이 적용되는 앱 역할. 비밀번호는 로컬 개발용입니다.
DATABASE_URL=postgres://class_coach_app:class_coach_app@127.0.0.1:54329/class_coach

# 마이그레이션·처리 서버·로그인 조회용. 행 보안을 우회합니다.
DATABASE_ADMIN_URL=postgres://class_coach:class_coach@127.0.0.1:54329/class_coach

# 녹음 파일은 이 디렉터리에 둡니다. 재생은 짧은 서명 URL만 씁니다.
DATA_DIR=data

# 16자 이상. 재생 주소 서명에 씁니다.
SIGNING_SECRET=replace-with-a-long-random-string

# 이어 올리기 청크. 기본 5MiB. 1GiB 영상을 올리려면 청크가 너무 작으면 안 됩니다.
UPLOAD_CHUNK_BYTES=5242880

# 처리기. local-band 는 수업 B 고정 결과를 돌려줍니다.
# process-run 은 process.py run 을 호출합니다(전사는 이 컴퓨터, 분석은 Anthropic API).
PROCESSOR_ID=local-band

# process-run 에만 필요합니다. 값은 로그나 화면에 찍지 않습니다.
ANTHROPIC_API_KEY=
