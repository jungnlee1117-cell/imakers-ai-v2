# 브라우저에는 API 주소와 이미지 provider 이름만 전달됩니다.
VITE_AI_API_BASE=/api
VITE_IMAGE_PROVIDER=fal

# 아래 값은 Express 서버에서만 읽습니다. VITE_ 접두사를 붙이지 마세요.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FAL_KEY=

# 선택 설정
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1.5
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-20250514
FAL_TEXT_TO_IMAGE_MODEL=fal-ai/flux-pro/kontext/text-to-image
FAL_EDIT_MODEL=fal-ai/flux-pro/kontext
API_PORT=43128